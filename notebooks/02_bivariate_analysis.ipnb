   "source": [
    "departure_order = [\"No delay\", \"Short (1-15)\", \"Moderate (16-60)\", \"Long (>60)\"]\n",
    "arrival_order = departure_order + [\"Missing\"]\n",
    "departure_band_summary = outcome_summary(\"departure_delay_band\", departure_order)\n",
    "arrival_band_summary = outcome_summary(\"arrival_delay_band\", arrival_order)\n",
    "display(Markdown(\"**Departure-delay bands**\"))\n",
    "display_outcome_table(departure_band_summary)\n",
    "display(Markdown(\"**Arrival-delay bands**\"))\n",
    "display_outcome_table(arrival_band_summary)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "delay-band-plots",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-13T06:55:54.570772Z",
     "iopub.status.busy": "2026-08-13T06:55:54.570709Z",
