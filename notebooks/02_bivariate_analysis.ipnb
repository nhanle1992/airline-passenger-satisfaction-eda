   "source": [
    "service_variables = {\n",
    "    \"cleanliness_rating_clean\": \"Cleanliness\",\n",
    "    \"seat_comfort_rating_clean\": \"Seat comfort\",\n",
    "    \"onboard_service_rating_clean\": \"Onboard service\",\n",
    "}\n",
    "service_tables = {}\n",
    "for column, label in service_variables.items():\n",
    "    table = outcome_summary(column, order=[1, 2, 3, 4, 5]).rename(columns={column: \"Rating\"})\n",
    "    service_tables[label] = table\n",
    "    display(Markdown(f\"**{label} rating and satisfaction**\"))\n",
    "    display_outcome_table(table)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "service-rate-plots",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-13T06:55:53.219718Z",
     "iopub.status.busy": "2026-08-13T06:55:53.219636Z",
     "iopub.status.idle": "2026-08-13T06:55:53.413474Z",
     "shell.execute_reply": "2026-08-13T06:55:53.413146Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1980x550 with 3 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "fig, axes = plt.subplots(1, 3, figsize=(18, 5), sharey=True)\n",
    "for ax, (label, table), color in zip(axes, service_tables.items(), COLORS):\n",
    "    sns.lineplot(data=table, x=\"Rating\", y=\"Satisfaction_rate\", marker=\"o\", linewidth=2.5, color=color, ax=ax)\n",
    "    ax.set(title=f\"Satisfaction rate by {label.lower()} rating\", xlabel=f\"{label} rating\", ylabel=\"Satisfaction rate\", ylim=(0, 1))\n",
    "    ax.yaxis.set_major_formatter(PercentFormatter(1))\n",
    "    ax.set_xticks([1, 2, 3, 4, 5])\n",
    "    for x, y, n in zip(table[\"Rating\"], table[\"Satisfaction_rate\"], table[\"Passengers\"]):\n",
    "        ax.annotate(f\"{y:.1%}\\nn={n:,}\", (x, y), textcoords=\"offset points\", xytext=(0, 8), ha=\"center\", fontsize=8)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
