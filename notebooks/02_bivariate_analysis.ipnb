     "output_type": "display_data"
    }
   ],
   "source": [
    "fig, axes = plt.subplots(1, 2, figsize=(16, 5), sharey=True)\n",
    "for ax, table, category, title in [\n",
    "    (axes[0], departure_band_summary, \"departure_delay_band\", \"Satisfaction rate by departure-delay band\"),\n",
    "    (axes[1], arrival_band_summary, \"arrival_delay_band\", \"Satisfaction rate by arrival-delay band\"),\n",
    "]:\n",
    "    sns.barplot(data=table, x=category, y=\"Satisfaction_rate\", color=COLORS[1], ax=ax)\n",
    "    ax.set(title=title, xlabel=\"Delay band\", ylabel=\"Satisfaction rate\", ylim=(0, .6))\n",
    "    ax.yaxis.set_major_formatter(PercentFormatter(1))\n",
    "    ax.tick_params(axis=\"x\", rotation=18)\n",
    "    annotate_rates(ax)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "delay-fine-bins",
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-08-13T06:55:54.673488Z",
     "iopub.status.busy": "2026-08-13T06:55:54.673428Z",
     "iopub.status.idle": "2026-08-13T06:55:54.820611Z",
     "shell.execute_reply": "2026-08-13T06:55:54.820254Z"
    }
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1760x550 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "fine_edges = [-1, 0, 15, 30, 60, 120, 240, np.inf]\n",
    "fine_labels = [\"0\", \"1-15\", \"16-30\", \"31-60\", \"61-120\", \"121-240\", \"241+\"]\n",
    "fig, axes = plt.subplots(1, 2, figsize=(16, 5), sharey=True)\n",
    "for ax, column, title in [\n",
    "    (axes[0], \"departure_delay\", \"Finer view: departure delay and satisfaction\"),\n",
    "    (axes[1], \"arrival_delay\", \"Finer view: arrival delay and satisfaction\"),\n",
    "]:\n",
    "    temporary_band = pd.cut(df[column], bins=fine_edges, labels=fine_labels)\n",
    "    table = (df.assign(delay_interval=temporary_band).groupby(\"delay_interval\", observed=True).agg(Passengers=(\"passenger_id\", \"size\"), Satisfaction_rate=(\"is_satisfied\", \"mean\")).reset_index())\n",
    "    sns.lineplot(data=table, x=\"delay_interval\", y=\"Satisfaction_rate\", marker=\"o\", color=COLORS[3], ax=ax)\n",
    "    ax.set(title=title, xlabel=\"Delay interval (dataset units)\", ylabel=\"Satisfaction rate\", ylim=(0, .6))\n",
    "    ax.yaxis.set_major_formatter(PercentFormatter(1))\n",
    "    ax.tick_params(axis=\"x\", rotation=20)\n",
    "    for x, row in enumerate(table.itertuples()):\n",
    "        ax.annotate(f\"{row.Satisfaction_rate:.1%}\\nn={row.Passengers:,}\", (x, row.Satisfaction_rate), textcoords=\"offset points\", xytext=(0, 8), ha=\"center\", fontsize=8)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "h3-note",
   "metadata": {},
   "source": [
    "**Descriptive reading only:** Delay intervals are analyst-defined summaries. The visual pattern does not establish a statistically significant or causal effect, and no missing-delay imputation has been performed."
   ]
  },
  {
   "cell_type": "markdown",
   "id": "41b22229",
   "metadata": {},
   "source": [
    "## 5. Retention proxy across satisfaction and experience levels\n",
    "\n",
    "**Definition and limitation:** `customer_type = Returning` is used as a retention proxy. The dataset does not track the same customer over time, so the figures below show the **share of surveyed passengers labeled Returning**, not a true cohort-retention rate.\n",
    "\n",
    "This section descriptively compares the proxy across satisfaction outcomes and within service-rating, travel-class, and delay groups. No statistical tests or causal conclusions are included."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "8bb2ea9e",
   "metadata": {
    "execution": {
